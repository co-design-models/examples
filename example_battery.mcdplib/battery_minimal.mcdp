mcdp {
 provides endurance [s]
 provides payload   [kg]
 battery = instance mcdp {
    provides capacity [J]
    requires mass     [kg]
    ignore unconnected
  }
 actuation = instance mcdp {
    provides lift  [N]
    requires power [W]
    ignore unconnected
  }
 capacity provided by battery ≽ \
    provided endurance · (power required by actuation)
 g = 9.81 m/s²
 lift provided by actuation ≽ \
    (mass required by battery + provided payload) · g
}
